{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build codechef solution",
			"type": "shell",
			"command": "g++",
			"args": [
				"-std=c++17",
				"-g",
				"-O0",
				"-Wall",
				"${workspaceFolder}/codechef/solution.cpp",
				"-o",
				"${workspaceFolder}/codechef/solution"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"]
		}
	]
}
